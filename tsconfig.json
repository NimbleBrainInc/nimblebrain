{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "contracts/**/*.ts",
    "packages/server-sdk/**/*.ts",
    "packages/conversations/**/*.ts",
    "src/**/*.ts",
    "instrument/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "src/platform/*/ui", "packages/*/ui"]
}
