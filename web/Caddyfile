{
	# Trust X-Forwarded-* headers from the ALB / private-VPC upstream.
	# Without this, Caddy overwrites X-Forwarded-Proto with its own
	# listener scheme (http on :8080), hiding the real https from the
	# upstream agent and breaking MCP OAuth resource-URL validation.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Status-transparent passthrough: the upstream's HTTP status must reach the
	# browser unaltered. The web client distinguishes a 401 (log out) from a 503
	# (`/v1/auth/refresh` transient — keep session, retry), so do NOT add
	# `handle_errors`, a friendly error page, or passive health-checks here that
	# would rewrite or swallow upstream 5xx on /v1/*.
	handle /v1/* {
		reverse_proxy {$PLATFORM_URL}
	}
	handle /mcp* {
		reverse_proxy {$PLATFORM_URL}
	}
	handle /.well-known/* {
		reverse_proxy {$PLATFORM_URL}
	}
	# Runtime client config. Served dynamically from NB_* env (substituted at
	# config load) so one static, read-only image is configured per tenant via
	# Helm — no writable filesystem, no entrypoint. index.html loads this before
	# the app bundle (window.__NB_CONFIG__, read by web/src/config.ts). Public
	# client values ONLY — never secrets. Unset env => empty field => feature off.
	#
	# Every value is emitted as a JSON *string* (incl. enabled/tracesSampleRate),
	# and config.ts coerces booleans/numbers. This way a malformed operator value
	# (e.g. NB_SENTRY_ENABLED=yes) degrades that one feature to "off" instead of
	# producing invalid JS that would disable every feature at once.
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.__NB_CONFIG__ = {"tenantId":"{$NB_TENANT_ID:}","environment":"{$NB_SENTRY_ENV:}","release":"{$NB_VERSION:}","sentry":{"dsn":"{$NB_SENTRY_DSN:}","enabled":"{$NB_SENTRY_ENABLED:false}","tracesSampleRate":"{$NB_SENTRY_TRACES_SAMPLE_RATE:0}"},"posthog":{"key":"{$NB_POSTHOG_KEY:}","enabled":"{$NB_POSTHOG_ENABLED:false}"}};` 200
	}
	# Content-hashed build output, served WITHOUT the SPA fallback.
	#
	# A hashed asset either exists or it does not: its name embeds its content, so
	# no other file is a valid answer. Under a shared `try_files … /index.html` a
	# missing one returns `200 text/html` — the app's own index page, with the
	# font/script CORS headers attached — which reads as healthy in devtools and in
	# logs while the browser quietly fails to parse it. A stale font URL then looks
	# exactly like the bug this channel exists to fix, and `stale-chunk-recovery.ts`
	# is written against the 404 that never arrives. Own handler, no fallback, 404.
	handle /assets/* {
		encode zstd gzip
		root * /srv
		# Immutable: the hash changes when the bytes do, so nothing needs revalidating.
		# Scoped to files that exist, because `header` applies to a 404 too — and a
		# year-long `immutable` 404 would strand a browser that asked mid-deploy, before
		# the pod serving the new asset was up, long after the asset arrived.
		@exists file {path}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		# Fonts are fetched in CORS mode by every browser, and an embedded app runs
		# in an OPAQUE origin (its iframe is `srcdoc` without `allow-same-origin`),
		# so its font requests arrive here cross-origin with `Origin: null` — even
		# though we are the origin that served the app. Without this the face is
		# blocked and the app silently falls back to system-ui, which is the exact
		# bug the `synapse/fontFaces` channel exists to fix. `*` is correct and
		# minimal: a font is inert, and `null` cannot be allowlisted by name.
		# Existence-scoped for the same reason as the cache header: a header describes
		# the response it is attached to, and a 404's body is not a font. The browser
		# reports the same opaque `NetworkError` to `FontFace.load()` either way, so
		# attaching it to the miss buys nothing.
		@fonts {
			path *.woff2
			file {path}
		}
		header @fonts Access-Control-Allow-Origin "*"
		file_server
	}
	# Everything else: the SPA entry and any non-hashed file. Compression is scoped
	# to the static handlers only — deliberately not applied to the reverse-proxied
	# /v1 and /mcp routes, whose SSE/streamable-HTTP responses must not be buffered
	# by an encoder.
	handle {
		encode zstd gzip
		root * /srv
		# Must revalidate every load: a deploy rewrites index.html to point at the new
		# hashed chunks, so it has to be re-fetched to be picked up — no-cache forces
		# an ETag revalidation instead of leaving it to heuristic cache freshness,
		# which could otherwise serve a stale app after a deploy.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
