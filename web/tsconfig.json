{
  "compilerOptions": {
    // The floor Vite already builds to. Its default `baseline-widely-available`
    // target is Chrome 107 / Firefox 104 / Safari 16, so a lib older than the
    // syntax and library surface those ship makes the type-checker refuse code
    // the bundle would have run — `Object.hasOwn` (Safari 15.4) being the one
    // that bites, since the linter rewrites to it.
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__"]
}
