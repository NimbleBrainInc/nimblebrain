{
  "server_url": "http://127.0.0.1:8000/mcp",
  "card_path": "/mcp/server-card",
  "media_type": "application/mcp-server-card+json",
  "card": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
    "name": "com.example/probe",
    "version": "2.3.1",
    "description": "Tracks the probe's records.",
    "title": "Probe",
    "websiteUrl": "https://example.com/probe",
    "icons": [
      { "src": "http://192.0.2.10/probe.png", "mimeType": "image/png" },
      { "src": "data:image/png;base64,iVBORw0KGgo=", "mimeType": "image/png", "sizes": ["48x48"] }
    ],
    "_meta": {
      "ai.nimblebrain/host": {
        "host_version": "1.0",
        "placements": [
          {
            "slot": "sidebar.apps",
            "resourceUri": "ui://probe/board",
            "priority": 20,
            "label": "Probe",
            "route": "probe",
            "size": "full"
          },
          { "slot": "settings", "resourceUri": "ui://probe/settings" }
        ]
      }
    }
  },
  "host_reads": {
    "name": "com.example/probe",
    "title": "Probe",
    "description": "Tracks the probe's records.",
    "iconUrl": "data:image/png;base64,iVBORw0KGgo=",
    "ui": {
      "placements": [
        {
          "slot": "sidebar.apps",
          "resourceUri": "ui://probe/board",
          "priority": 20,
          "label": "Probe",
          "route": "probe",
          "size": "full"
        },
        { "slot": "settings", "resourceUri": "ui://probe/settings" }
      ]
    }
  }
}
