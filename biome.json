{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "files": {
    "includes": [
      "src/**",
      "web/src/**",
      "instrument/**",
      "scripts/**",
      "test/**/*.ts",
      "test/**/*.tsx",
      "!**/dist/**",
      "!web/src/_generated/**",
      "!web/src/assets/**"
    ]
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "src/**",
        "web/src/**",
        "test/conformance/**",
        "test/eval/**",
        "test/fixtures/**",
        "test/helpers/**",
        "test/integration/api/**",
        "test/integration/identity/**",
        "test/integration/security/**",
        "test/scripts/**",
        "test/unit/__golden__/**",
        "test/unit/brand/**",
        "test/unit/bridge/**",
        "test/unit/docs/**",
        "test/unit/engine/**",
        "test/unit/fixtures/**",
        "test/unit/lifecycle/**",
        "test/unit/middleware/**",
        "test/unit/oauth/**",
        "test/unit/orchestrator/**",
        "test/unit/platform/compose/**",
        "test/unit/scripts/**",
        "test/unit/services/**",
        "test/unit/usage/**",
        "test/unit/util/**"
      ],
      "plugins": ["./biome-plugins/double-cast.grit"]
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "suspicious": { "noTemplateCurlyInString": "off" }
        }
      }
    }
  ]
}
