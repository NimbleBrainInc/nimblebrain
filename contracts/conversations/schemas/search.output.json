{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/search.output.json",
  "type": "object",
  "required": [
    "results",
    "totalMatches"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "matches"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "snippet"
              ],
              "properties": {
                "snippet": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "totalMatches": {
      "type": "number"
    }
  }
}
