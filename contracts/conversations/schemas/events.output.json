{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/events.output.json",
  "type": "object",
  "required": [
    "events",
    "lastSeq"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seq",
          "event"
        ],
        "properties": {
          "seq": {
            "type": "integer"
          },
          "event": {
            "additionalProperties": true,
            "type": "object",
            "required": [
              "ts",
              "type"
            ],
            "properties": {
              "ts": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lastSeq": {
      "type": "integer"
    }
  }
}
