{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/app/list.output.json",
  "type": "object",
  "required": [
    "conversations",
    "nextCursor",
    "totalCount"
  ],
  "properties": {
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "messageCount",
          "totalInputTokens",
          "totalOutputTokens",
          "lastModel",
          "preview",
          "title",
          "ownerId",
          "workspaceId",
          "active"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "messageCount": {
            "type": "number"
          },
          "totalInputTokens": {
            "type": "number"
          },
          "totalOutputTokens": {
            "type": "number"
          },
          "lastModel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "preview": {
            "description": "The conversation's first user message, capped for the response.",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownerId": {
            "description": "The conversation's owner; null when its header names none.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "workspaceId": {
            "description": "The workspace whose directory holds the conversation.",
            "type": "string"
          },
          "active": {
            "description": "Whether a reply is generating for it right now.",
            "type": "boolean"
          }
        }
      }
    },
    "nextCursor": {
      "description": "Pass as `cursor` for the next page; null on the last page.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "totalCount": {
      "type": "number"
    }
  }
}
