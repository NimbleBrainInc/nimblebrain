{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/app/stats.output.json",
  "type": "object",
  "required": [
    "period",
    "totalConversations",
    "totalInputTokens",
    "totalOutputTokens",
    "byModel",
    "topTools"
  ],
  "properties": {
    "period": {
      "type": "object",
      "required": [
        "since",
        "until"
      ],
      "properties": {
        "since": {
          "description": "ISO 8601 lower bound; \"\" for period \"all\".",
          "type": "string"
        },
        "until": {
          "type": "string"
        }
      }
    },
    "totalConversations": {
      "type": "number"
    },
    "totalInputTokens": {
      "type": "number"
    },
    "totalOutputTokens": {
      "type": "number"
    },
    "byModel": {
      "description": "Usage keyed by model id.",
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "object",
          "required": [
            "inputTokens",
            "outputTokens",
            "conversations"
          ],
          "properties": {
            "inputTokens": {
              "type": "number"
            },
            "outputTokens": {
              "type": "number"
            },
            "conversations": {
              "description": "Conversations with a turn on this model.",
              "type": "number"
            }
          }
        }
      }
    },
    "topTools": {
      "description": "Tools by call count, most-called first.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "callCount"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "callCount": {
            "type": "number"
          }
        }
      }
    }
  }
}
