{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/export.input.json",
  "required": [
    "format"
  ],
  "type": "object",
  "properties": {
    "id": {
      "description": "Conversation ID. Omit it (or pass \"current\") to address the conversation this call is happening inside; required from outside a chat.",
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "json"
      ],
      "description": "Export format."
    }
  }
}
