{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/events.input.json",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "afterSeq": {
      "minimum": 0,
      "type": "integer"
    },
    "throughSeq": {
      "minimum": 0,
      "type": "integer"
    },
    "limit": {
      "minimum": 1,
      "maximum": 5000,
      "type": "integer"
    }
  }
}
