{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/search.input.json",
  "required": [
    "query"
  ],
  "type": "object",
  "properties": {
    "query": {
      "description": "Search query. Case-insensitive substring match on message content.",
      "type": "string"
    },
    "limit": {
      "description": "Max conversations to return. Default: 10.",
      "type": "number"
    }
  }
}
