{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/records/search.output.json",
  "type": "object",
  "required": [
    "items",
    "nextCursor",
    "total"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "matches"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "seq",
                "snippet"
              ],
              "properties": {
                "seq": {
                  "type": "integer"
                },
                "snippet": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "total": {
      "type": "integer"
    }
  }
}
