{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/records/search.input.json",
  "type": "object",
  "required": [
    "text",
    "limit"
  ],
  "properties": {
    "text": {
      "minLength": 1,
      "type": "string"
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "maximum": 200,
      "type": "integer"
    }
  }
}
