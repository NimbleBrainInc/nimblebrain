{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/ai.nimblebrain.conversations/1/records/list.input.json",
  "type": "object",
  "required": [
    "limit"
  ],
  "properties": {
    "text": {
      "type": "string"
    },
    "updatedFrom": {
      "type": "string"
    },
    "updatedTo": {
      "type": "string"
    },
    "sort": {
      "anyOf": [
        {
          "const": "updated",
          "type": "string"
        },
        {
          "const": "created",
          "type": "string"
        }
      ]
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "minimum": 1,
      "maximum": 200,
      "type": "integer"
    }
  }
}
