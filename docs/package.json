{
  "name": "nimblebrain-docs",
  "packageManager": "bun@1.4.3",
  "description": "Documentation site for NimbleBrain Platform, the open-source runtime that runs agents and MCP apps on your systems, with any model",
  "type": "module",
  "version": "0.0.1",
  "license": "CC-BY-4.0",
  "author": "NimbleBrain Inc <engineering@nimblebrain.ai>",
  "homepage": "https://docs.nimblebrain.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/nimblebrain.git",
    "directory": "docs"
  },
  "keywords": [
    "nimblebrain",
    "mcp",
    "documentation",
    "model-context-protocol"
  ],
  "scripts": {
    "reference": "uv run --project ../packages/server-sdk-py --frozen --all-extras --python 3.13 --with griffe==2.4.1 python scripts/server_sdk_reference.py",
    "test:reference": "uv run --project ../packages/server-sdk-py --frozen --all-extras --python 3.13 --with griffe==2.4.1 --with pytest python -B -m pytest -p no:cacheprovider scripts/",
    "predev": "bun run reference",
    "dev": "astro dev",
    "prebuild": "bun run reference",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "astro": "^7.2.10",
    "sharp": "^0.35.0",
    "starlight-sidebar-topics": "^0.9.0"
  },
  "devDependencies": {
    "starlight-links-validator": "^0.27.0"
  },
  "overrides": {
    "undici": "^8.12.2",
    "vite": "^8.3.3",
    "zod": "^4.6.6"
  }
}
