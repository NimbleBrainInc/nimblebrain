{
  "name": "nimblebrain",
  "packageManager": "bun@1.4.4",
  "version": "0.0.0-dev",
  "description": "Open-source runtime that runs agents and MCP apps on your systems, with any model",
  "license": "Apache-2.0",
  "author": "NimbleBrain, Inc. <oss@nimblebrain.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NimbleBrainInc/nimblebrain.git"
  },
  "homepage": "https://github.com/NimbleBrainInc/nimblebrain",
  "keywords": [
    "mcp",
    "agent",
    "runtime",
    "orchestration",
    "model-context-protocol",
    "ai",
    "llm",
    "multi-agent",
    "bun"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "type": "module",
  "files": [
    "src/",
    "schemas/",
    "nimblebrain.json",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:empty": "NB_API_PORT=27249 NB_WEB_PORT=27248 bun --no-env-file scripts/dev.ts --port 27249 --config .environments/empty/nimblebrain.json",
    "dev:minimal": "NB_API_PORT=27251 NB_WEB_PORT=27250 bun --no-env-file scripts/dev.ts --port 27251 --config .environments/minimal/nimblebrain.json",
    "dev:docs-demo": "NB_API_PORT=27253 NB_WEB_PORT=27252 bun --no-env-file scripts/dev.ts --port 27253 --config .environments/docs-demo/nimblebrain.json",
    "dev:plugins-demo": "bun --no-env-file scripts/dev-plugins-demo.ts",
    "dev:scheduled-demo": "bun --no-env-file scripts/dev-scheduled-demo.ts",
    "dev:worktree": "bun --no-env-file scripts/dev-worktree.ts",
    "dev:api": "bun run scripts/dev.ts --no-web",
    "dev:web": "cd web && bun run dev",
    "start": "bun run src/cli/index.ts serve",
    "install:platform-apps": "for ui in src/platform/*/ui; do [ -f \"$ui/package.json\" ] || continue; (cd \"$ui\" && bun install --frozen-lockfile) || exit 1; done",
    "build:platform-apps": "for ui in src/platform/*/ui; do [ -f \"$ui/package.json\" ] && (cd \"$ui\" && bun install && bun run build); done",
    "docs:install": "cd docs && bun install",
    "docs:dev": "cd docs && bun run dev",
    "docs:build": "cd docs && bun run build",
    "test:unit": "bun test --no-env-file test/unit/",
    "test:integration": "bun test --no-env-file test/integration/",
    "test:conformance": "bun --no-env-file test/conformance/run.ts",
    "test": "bun run test:unit && bun run test:integration",
    "test:web": "cd web && bun run test",
    "test:platform-apps": "for ui in src/platform/*/ui; do if [ -f \"$ui/package.json\" ] && [ -n \"$(find \"$ui/src\" \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print -quit 2>/dev/null)\" ]; then (cd \"$ui\" && bun test --isolate) || exit 1; fi; done",
    "eval": "bun test test/eval/",
    "check:platform-app-transport": "bun run scripts/check-platform-app-transport.ts",
    "check:workspace-paths": "bun run scripts/check-workspace-paths.ts",
    "check:conversation-paths": "bun run scripts/check-conversation-paths.ts",
    "check:tool-namespace": "bun run scripts/check-tool-namespace.ts",
    "check:workspace-splat-nesting": "bun run scripts/check-workspace-splat-nesting.ts",
    "check:credential-paths": "bun run scripts/check-credential-paths.ts",
    "check:public-origin": "bun run scripts/check-public-origin.ts",
    "check:file-paths": "bun run scripts/check-file-paths.ts",
    "check:task-paths": "bun run scripts/check-task-paths.ts",
    "check:resource-schemes": "bun run scripts/check-resource-schemes.ts",
    "check:rest-responses": "bun run scripts/check-rest-responses.ts",
    "check:internal-hosts": "bun run scripts/check-internal-hosts.ts",
    "check:web-index-hosts": "bun run scripts/check-web-index-hosts.ts",
    "check:catalog-schema": "bun run scripts/check-catalog-schema.ts src/connectors/catalog/curated",
    "check:usage-record": "bun run scripts/check-usage-record.ts",
    "check:test-signatures": "bun run scripts/check-test-signatures.ts",
    "check:platform-apps": "bun run scripts/check-platform-apps.ts",
    "check:core-skill-tool-refs": "bun run scripts/check-core-skill-tool-refs.ts",
    "codegen": "bun run scripts/codegen-web-platform-schemas.ts",
    "gen:host-constants": "cd web && bun run gen:host-constants",
    "check:codegen": "bun run codegen && bun run scripts/check-codegen.ts",
    "verify": "bun run verify:static && bun run verify:test-unit && bun run test:integration",
    "verify:static": "bun run --sequential --no-exit-on-error format:check lint check \"check:*\"",
    "verify:test-unit": "bun run test:unit && bun run test:ui && bun run test:cli",
    "test:ui": "bun run test:web && bun run test:platform-apps",
    "test:cli": "cd packages/cli && bun test --no-env-file test/",
    "check": "bunx tsc --noEmit",
    "check:web": "cd web && bunx tsc --noEmit",
    "check:cli": "bunx tsc --noEmit -p packages/cli && cd packages/cli && bun run build && node dist/nimblebrain.js --version",
    "check:web-tests": "bun run scripts/check-web-tests.ts",
    "check:theme": "cd web && bun run check:theme",
    "lint": "bunx @biomejs/biome check src/ instrument/ scripts/ web/src/ web/test/ test/ packages/cli/src/ packages/cli/test/",
    "format": "bunx @biomejs/biome format --write src/ web/src/ web/test/ instrument/ scripts/ test/ packages/cli/src/ packages/cli/test/",
    "format:check": "bunx @biomejs/biome format src/ web/src/ web/test/ instrument/ scripts/ test/ packages/cli/src/ packages/cli/test/",
    "sync-models": "bun run src/model/sync-models.ts && bunx @biomejs/biome format --write src/model/catalog-data.json",
    "sync-nebius": "bun run src/model/sync-nebius.ts && bunx @biomejs/biome format --write src/model/catalog-nebius.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nimblebrain/synapse": "0.39.0",
    "@types/bun": "latest",
    "happy-dom": "^20.0.0",
    "mcp-sdk-v1": "npm:@modelcontextprotocol/sdk@1.32.2",
    "nimblebrain-agent": "github:NimbleBrainInc/nimblebrain-agent#068c7996ced24810794313f776ed0b3b2293368c",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5 || ^7.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/provider-utils": "^5.0.44",
    "@ai-sdk/xai": "^4.0.0",
    "@composio/core": "0.25.0",
    "@e965/xlsx": "0.20.3",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.3.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/bun": "^10.58.0",
    "@sinclair/typebox": "^0.34.49",
    "@workos-inc/node": "^10.0.0",
    "ai": "^7.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "croner": "^10.0.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.14",
    "mammoth": "^1.12.0",
    "posthog-node": "^5.63.1",
    "prom-client": "^15.1.3",
    "unpdf": "^1.6.0",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13",
    "undici": "^7.30.1"
  }
}
