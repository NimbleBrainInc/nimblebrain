{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nimblebrain.ai/contracts/files/v1/contract.json",
  "title": "Files contract",
  "description": "The ai.nimblebrain.files contract: its identity, version, cardinality, its tools with their visibility, unattended marking and schemas, and the closed list of errors. Every tool error is a tools/call result with isError: true whose first text content is JSON {code, error}. A private tool's code is from errors.private. A public tool's code, and the answer to a tool name the server does not have, is from errors.public, and its error begins with that entry's prefix. Beyond the prefix, error is diagnostic. A request refused before any tool runs is the transport's answer and outside this list. Normative rules: contracts/files/CONTRACT.md in the NimbleBrain repository.",
  "contract": "ai.nimblebrain.files",
  "version": "1.0",
  "cardinality": "singleton",
  "tools": {
    "list": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/list_input"
      },
      "output": {
        "$ref": "#/$defs/list_output"
      }
    },
    "search": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/search_input"
      },
      "output": {
        "$ref": "#/$defs/search_output"
      }
    },
    "info": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/info_input"
      },
      "output": {
        "$ref": "#/$defs/info_output"
      }
    },
    "read": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/read_input"
      },
      "output": {
        "$ref": "#/$defs/read_output"
      }
    },
    "create": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/create_input"
      },
      "output": {
        "$ref": "#/$defs/create_output"
      }
    },
    "tag": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/tag_input"
      },
      "output": {
        "$ref": "#/$defs/tag_output"
      }
    },
    "move": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/move_input"
      },
      "output": {
        "$ref": "#/$defs/move_output"
      }
    },
    "delete": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/delete_input"
      },
      "output": {
        "$ref": "#/$defs/delete_output"
      }
    },
    "create_folder": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/create_folder_input"
      },
      "output": {
        "$ref": "#/$defs/create_folder_output"
      }
    },
    "update_folder": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/update_folder_input"
      },
      "output": {
        "$ref": "#/$defs/update_folder_output"
      }
    },
    "delete_folder": {
      "visibility": "public",
      "unattended": "allowed",
      "input": {
        "$ref": "#/$defs/delete_folder_input"
      },
      "output": {
        "$ref": "#/$defs/delete_folder_output"
      }
    },
    "record": {
      "visibility": "private",
      "unattended": "refused",
      "input": {
        "$ref": "#/$defs/record_input"
      },
      "output": {
        "$ref": "#/$defs/record_output"
      }
    },
    "resolve": {
      "visibility": "private",
      "unattended": "refused",
      "input": {
        "$ref": "#/$defs/resolve_input"
      },
      "output": {
        "$ref": "#/$defs/resolve_output"
      }
    },
    "released": {
      "visibility": "private",
      "unattended": "refused",
      "input": {
        "$ref": "#/$defs/released_input"
      },
      "output": {
        "$ref": "#/$defs/released_output"
      }
    },
    "delete_workspace": {
      "visibility": "private",
      "unattended": "refused",
      "input": {
        "$ref": "#/$defs/delete_workspace_input"
      },
      "output": {
        "$ref": "#/$defs/delete_workspace_output"
      }
    }
  },
  "errors": {
    "public": [
      {
        "code": "file_not_found",
        "prefix": "File not found: ",
        "meaning": "An id names no file in the caller's scope: another owner's, another workspace's, a deleted and a missing one answer alike. For move, any one id; nothing moved."
      },
      {
        "code": "folder_not_found",
        "prefix": "Folder not found: ",
        "meaning": "A folder id names no folder in the caller's scope. Nothing was written."
      },
      {
        "code": "conflict",
        "prefix": "Conflict: ",
        "meaning": "The call contradicts what is stored: a folder name already taken beside it, a folder moved into itself or a folder inside it, a folder deleted while it holds files or folders. Nothing was written."
      },
      {
        "code": "not_paged",
        "prefix": "Not a paged document: ",
        "meaning": "read named pages of a file whose type has none (1.0 pages PDFs only)."
      },
      {
        "code": "extraction_failed",
        "prefix": "Text extraction failed: ",
        "meaning": "read named pages, and the document's text could not be extracted within the implementation's bounds. A read without pages answers extractedText: null instead."
      },
      {
        "code": "too_large",
        "prefix": "Too large: ",
        "meaning": "create's body, decoded, is over the contract's limit (CONTRACT.md §7). Nothing was written."
      },
      {
        "code": "scope_missing",
        "prefix": "[files] no ",
        "meaning": "tools/call reached a public tool with no workspace or no authenticated identity in its scope."
      },
      {
        "code": "invalid_input",
        "prefix": "Invalid arguments for ",
        "meaning": "The arguments do not match the tool's input schema, or a rule the schema cannot state (a body that is not the base64 its encoding names, a folder path with an empty segment); the tool name follows the prefix, quoted. Nothing was written."
      },
      {
        "code": "unknown_tool",
        "prefix": "Unknown tool ",
        "meaning": "No tool by that name, public or private."
      }
    ],
    "private": [
      {
        "code": "forbidden",
        "meaning": "A private tool was called by a principal other than host. Checked before the input and the scope, so the answer reveals nothing about either. Nothing was read or written."
      },
      {
        "code": "invalid_input",
        "meaning": "The arguments do not match the tool's input schema. Nothing was written."
      },
      {
        "code": "scope_missing",
        "meaning": "The call reached the server with no workspace in its scope, or record or resolve with no owner. Nothing was read or written."
      },
      {
        "code": "internal_error",
        "meaning": "Anything else. The error text is diagnostic only."
      }
    ]
  },
  "$defs": {
    "list_input": {
      "type": "object",
      "properties": {
        "folderId": {
          "pattern": "^(root|[a-z0-9][a-z0-9_-]{0,63})$",
          "description": "Folder to list, by id; \"root\" for the top level. Omit to list files across every folder. When set, the result also holds the folders inside it.",
          "type": "string"
        },
        "recursive": {
          "description": "With `folderId`, include files in its subfolders too. Default: false.",
          "type": "boolean"
        },
        "query": {
          "description": "Case-insensitive text to match in the filename, description, or tags (and folder names).",
          "type": "string"
        },
        "kinds": {
          "description": "Keep only files of these kinds, judged from the MIME type.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "image",
              "document",
              "data",
              "font",
              "other"
            ]
          }
        },
        "sources": {
          "description": "Keep only files from these sources: \"chat\" (attached in a chat), \"agent\" (written by an agent), \"app\" or \"manual\" (uploaded).",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "chat",
              "agent",
              "app",
              "manual"
            ]
          }
        },
        "conversationId": {
          "description": "Keep only files attached in or written by this conversation.",
          "type": "string"
        },
        "runId": {
          "description": "Keep only files written by this task run.",
          "type": "string"
        },
        "createdAfter": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}",
          "description": "Keep only files created at or after this ISO 8601 date or time.",
          "type": "string"
        },
        "createdBefore": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}",
          "description": "Keep only files created before this ISO 8601 date or time.",
          "type": "string"
        },
        "tags": {
          "description": "Filter by tags (files must have ALL specified tags).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mimeType": {
          "description": "Filter by MIME type prefix (e.g. 'image/' matches image/png, image/jpeg).",
          "type": "string"
        },
        "sort": {
          "type": "string",
          "enum": [
            "createdAt",
            "filename",
            "size"
          ],
          "description": "Sort field. Default: \"createdAt\"."
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "description": "Sort direction. Default: \"desc\" for createdAt and size (newest, largest first), \"asc\" for filename."
        },
        "limit": {
          "minimum": 1,
          "maximum": 200,
          "description": "Max files to return. Default: 20.",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "description": "Number of files to skip. Default: 0.",
          "type": "integer"
        }
      }
    },
    "list_output": {
      "type": "object",
      "required": [
        "files",
        "total",
        "folders",
        "breadcrumb",
        "facets"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "filename",
              "mimeType",
              "size",
              "tags",
              "source",
              "conversationId",
              "createdAt",
              "description",
              "folderPath"
            ],
            "properties": {
              "id": {
                "description": "The file's id: its URI is files://<id>.",
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "description": "The body's size in bytes.",
                "type": "number"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "description": "Where the file came from. Known values: chat, agent, app, manual. Any other is unknown (CONTRACT.md §5).",
                "type": "string"
              },
              "conversationId": {
                "description": "The conversation the file was attached in or written by, or null.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "runId": {
                "description": "The unattended run that wrote the file, or null.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "description": "When the record was made (RFC 3339).",
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "folderId": {
                "description": "The file's folder, or null at the top level.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ownerId": {
                "description": "Advisory: the owner the file belongs to.",
                "type": "string"
              },
              "workspaceId": {
                "description": "Advisory: the workspace the file belongs to.",
                "type": "string"
              },
              "folderPath": {
                "type": "string"
              }
            }
          }
        },
        "total": {
          "description": "Every match, across pages.",
          "type": "integer"
        },
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "parentId",
              "createdAt",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "breadcrumb": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "facets": {
          "type": "object",
          "required": [
            "kinds",
            "sources"
          ],
          "properties": {
            "kinds": {
              "type": "object",
              "required": [
                "image",
                "document",
                "data",
                "font",
                "other"
              ],
              "properties": {
                "image": {
                  "type": "integer"
                },
                "document": {
                  "type": "integer"
                },
                "data": {
                  "type": "integer"
                },
                "font": {
                  "type": "integer"
                },
                "other": {
                  "type": "integer"
                }
              }
            },
            "sources": {
              "type": "object",
              "required": [
                "chat",
                "agent",
                "app",
                "manual"
              ],
              "properties": {
                "chat": {
                  "type": "integer"
                },
                "agent": {
                  "type": "integer"
                },
                "app": {
                  "type": "integer"
                },
                "manual": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "search_input": {
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "Search query.",
          "type": "string"
        },
        "tags": {
          "description": "Filter by tags.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mimeType": {
          "description": "Filter by MIME type prefix.",
          "type": "string"
        },
        "limit": {
          "description": "Max results. Default: 20.",
          "type": "number"
        }
      }
    },
    "search_output": {
      "type": "object",
      "required": [
        "files",
        "total"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "filename",
              "mimeType",
              "size",
              "tags",
              "source",
              "conversationId",
              "createdAt",
              "description"
            ],
            "properties": {
              "id": {
                "description": "The file's id: its URI is files://<id>.",
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "description": "The body's size in bytes.",
                "type": "number"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "description": "Where the file came from. Known values: chat, agent, app, manual. Any other is unknown (CONTRACT.md §5).",
                "type": "string"
              },
              "conversationId": {
                "description": "The conversation the file was attached in or written by, or null.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "runId": {
                "description": "The unattended run that wrote the file, or null.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "description": "When the record was made (RFC 3339).",
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "folderId": {
                "description": "The file's folder, or null at the top level.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ownerId": {
                "description": "Advisory: the owner the file belongs to.",
                "type": "string"
              },
              "workspaceId": {
                "description": "Advisory: the workspace the file belongs to.",
                "type": "string"
              }
            }
          }
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "info_input": {
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "File ID.",
          "type": "string"
        }
      }
    },
    "info_output": {
      "type": "object",
      "required": [
        "id",
        "filename",
        "mimeType",
        "size",
        "tags",
        "source",
        "conversationId",
        "createdAt",
        "description"
      ],
      "properties": {
        "id": {
          "description": "The file's id: its URI is files://<id>.",
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "description": "The body's size in bytes.",
          "type": "number"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "description": "Where the file came from. Known values: chat, agent, app, manual. Any other is unknown (CONTRACT.md §5).",
          "type": "string"
        },
        "conversationId": {
          "description": "The conversation the file was attached in or written by, or null.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "description": "The unattended run that wrote the file, or null.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "description": "When the record was made (RFC 3339).",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "folderId": {
          "description": "The file's folder, or null at the top level.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerId": {
          "description": "Advisory: the owner the file belongs to.",
          "type": "string"
        },
        "workspaceId": {
          "description": "Advisory: the workspace the file belongs to.",
          "type": "string"
        }
      }
    },
    "read_input": {
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "File ID.",
          "type": "string"
        },
        "pages": {
          "minItems": 1,
          "maxItems": 10,
          "description": "Read only these 1-based pages of a paged document (a PDF), at most 10 per call. Use it for a long PDF, or for pages past the truncated text. Omit to read the whole text.",
          "type": "array",
          "items": {
            "minimum": 1,
            "description": "1-based page number.",
            "type": "integer"
          }
        }
      }
    },
    "read_output": {
      "type": "object",
      "required": [
        "id",
        "filename",
        "mimeType",
        "size",
        "extractedText",
        "truncated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "size": {
          "type": "number"
        },
        "extractedText": {
          "description": "The file's text, when its type is extractable and extraction succeeded; null otherwise, and with `pages`.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "description": "Whether `extractedText` stops at the text bound.",
          "type": "boolean"
        },
        "totalPages": {
          "description": "With `pages`: the document's pages.",
          "type": "integer"
        },
        "requestedPages": {
          "description": "With `pages`: the pages asked for, sorted, once each.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "missingPages": {
          "description": "With `pages`: those past the document's end.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "pages": {
          "description": "With `pages`: each requested page that exists, in order.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "page",
              "text",
              "truncated",
              "empty"
            ],
            "properties": {
              "page": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean"
              },
              "empty": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "create_input": {
      "required": [
        "manifest",
        "body"
      ],
      "type": "object",
      "properties": {
        "manifest": {
          "required": [
            "filename",
            "mimeType"
          ],
          "type": "object",
          "properties": {
            "filename": {
              "description": "Filename (e.g. 'logo.png').",
              "type": "string"
            },
            "folder": {
              "description": "Folder path to put the file in, '/'-separated (e.g. 'Reports/Q3'). Folders that do not exist are created. Omit for the top level.",
              "type": "string"
            },
            "mimeType": {
              "description": "MIME type (e.g. 'image/png').",
              "type": "string"
            },
            "tags": {
              "description": "Optional tags for categorization.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "description": "Optional description of the file.",
              "type": "string"
            }
          }
        },
        "body": {
          "description": "File content, at most 4194304 bytes once decoded. Base64-encoded by default; pass encoding: \"text\" to write `body` verbatim.",
          "type": "string"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "base64",
            "text"
          ],
